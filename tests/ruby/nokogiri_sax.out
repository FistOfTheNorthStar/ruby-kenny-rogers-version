["hello", [:error, "Start tag expected, '<' not found\n"]]
["<a/><b/>", [:error, "Extra content at the end of the document\n"]]
["<a/>junk", [:error, "Extra content at the end of the document\n"]]
["<a x=\"1\" x=\"2\"/>", [:error, "Attribute x redefined\n"]]
["<a x=\"<\"/>", [:error, "Unescaped '<' not allowed in attributes values\n"]]
["<r>x]]>y</r>", [:error, "Sequence ']]>' not allowed in content\n"]]
["<r>c\u0001</r>", [:error, "PCDATA invalid Char value 1\n"]]
["<r>&#0;</r>", [:error, "xmlParseCharRef: invalid xmlChar value 0\n"]]
["<r a='1' b=2/>", [:error, "Couldn't find end of Start Tag r line 1\n"]]
["<r>a & b</r>", [:error, "xmlParseEntityRef: no name\n"]]
["<r><!-- a -- b --></r>", [:error, "Double hyphen within comment: <!-- a \n"]]
["<1r/>", [:error, "StartTag: invalid element name\n"]]
["<r><!-- abc</r>", [:error, "Comment not terminated\n"]]
["<r><![CDATA[abc</r>", [:error, "CData section not finished\nabc</\n"]]
["<r></r x>", [:error, "expected '>'\n"]]
["<r a/>", [:error, "Specification mandates value for attribute a\n"]]
["<r></>", [:error, "Opening and ending tag mismatch: r line 1 and unparsable\n"]]
["<r><?xml version='1.0'?></r>", [:error, "XML declaration allowed only at the start of the document\n"]]
[" <?xml version=\"1.0\"?><r/>", [:error, "XML declaration allowed only at the start of the document\n"]]
["<r/><!DOCTYPE r>", [:error, "Extra content at the end of the document\n"]]
["", [:raised, RuntimeError, "input string cannot be empty"]]
