== a map file beside the CSS
.part {
  color: red;
}
.part a {
  b: c;
}

/* kept */
.main {
  width: 10px;
}
.main .inner, .main .x {
  height: 5px;
}
@media (min-width: 10px) {
  .main {
    top: 0;
  }
}

@supports (display: grid) {
  .g {
    display: grid;
  }
}
@keyframes spin {
  from {
    left: 0;
  }
  to {
    left: 1px;
  }
}

