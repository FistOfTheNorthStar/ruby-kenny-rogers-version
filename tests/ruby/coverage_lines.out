== control.rb [:lines, :branches, :methods]
 nil   1: # Branches and loops of every kind (measured by coverage_lines.rb).
   1   2: module CovControl
   1   3:   def self.grade(n)
   4   4:     if n > 90
   1   5:       :a
   3   6:     elsif n > 75
   1   7:       :b
   2   8:     elsif n > 50 then :c
 nil   9:     else
   1  10:       :f
 nil  11:     end
 nil  12:   end
 nil  13: 
   1  14:   def self.sign(n)
   3  15:     return :zero if n == 0
   2  16:     n > 0 ? :pos : :neg
 nil  17:   end
 nil  18: 
   1  19:   def self.check(x)
   2  20:     unless x
   1  21:       "no"
 nil  22:     else
   1  23:       "yes"
 nil  24:     end
 nil  25:   end
 nil  26: 
   1  27:   def self.kind(v)
   5  28:     case v
 nil  29:     when Integer, Float
   1  30:       "num"
 nil  31:     when /\A\d+\z/
   1  32:       "digits"
   1  33:     when String then "str"
 nil  34:     when *[:a, :b]
   1  35:       "ab"
 nil  36:     else
   1  37:       "other"
 nil  38:     end
 nil  39:   end
 nil  40: 
   1  41:   def self.bare(n)
 nil  42:     case
   4  43:     when n < 0 then -1
 nil  44:     when n.zero?
   1  45:       0
 nil  46:     end
 nil  47:   end
 nil  48: 
   1  49:   def self.shape(v)
   5  50:     case v
 nil  51:     in [Integer => a, Integer => b]
   1  52:       a + b
 nil  53:     in {name: String => nm} if nm.size > 3
   1  54:       nm.upcase
 nil  55:     in {name:}
   1  56:       name
 nil  57:     in nil
   1  58:       nil
 nil  59:     else
   1  60:       :unknown
 nil  61:     end
 nil  62:   end
 nil  63: 
   1  64:   def self.loops(n)
   1  65:     i = 0
   1  66:     total = 0
   1  67:     while i < n
   4  68:       total += i
   4  69:       i += 1
 nil  70:     end
   1  71:     until i == 0
   4  72:       i -= 1
 nil  73:     end
   1  74:     begin
   3  75:       i += 2
 nil  76:     end while i < 5
   1  77:     for x in [1, 2, 3]
   3  78:       total += x
 nil  79:     end
   1  80:     total
 nil  81:   end
 nil  82: 
   1  83:   def self.safe(o)
   2  84:     o&.length
 nil  85:   end
 nil  86: 
   1  87:   def self.logic(a, b)
   2  88:     a && b || !a
 nil  89:   end
 nil  90: 
   1  91:   def self.mods(x)
   2  92:     y = 0
   2  93:     y += 1 if x
   2  94:     y += 2 unless x
   2  95:     y -= 1 while y > 5
   2  96:     y
 nil  97:   end
 nil  98: 
   1  99:   def self.never
   0 100:     1.times do
   0 101:       :never
 nil 102:     end
 nil 103:   end
 nil 104: end
