   1 107: p CovControl.sign(0), CovControl.sign(3), CovControl.sign(-3)
   1 108: p CovControl.check(nil), CovControl.check(1)
   1 109: p CovControl.kind(1), CovControl.kind("12"), CovControl.kind("x"), CovControl.kind(:a), CovControl.kind([])
   1 110: p CovControl.bare(-5), CovControl.bare(0), CovControl.bare(5)
   1 111: p CovControl.shape([1, 2]), CovControl.shape({name: "kenny"}), CovControl.shape({name: "ab"}), CovControl.shape(nil), CovControl.shape(3)
   1 112: p CovControl.loops(4)
